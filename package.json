    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "test:db": "tsx scripts/test-database.ts",
    "test:access": "node --env-file=.env.local --import tsx scripts/test-rest-access.ts",
    "accounts:provision": "node --env-file=.env.local --import tsx scripts/provision-accounts.ts",
    "data:import": "node --env-file=.env.local --import tsx scripts/import-seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "csv-parse": "7.0.2",
    "iconv-lite": "0.7.3",
    "libphonenumber-js": "1.13.13",
    "lucide-react": "1.45.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "postgres": "3.4.9",
    "prettier": "3.9.6",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=24 <25"
  },
  "type": "module"
