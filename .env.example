NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend/import tooling only. Never prefix secrets with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
VG_PROVIDER_API_KEY=
WORKER_SECRET=
SHARE_SESSION_SECRET=

# Enable after configuring Google and manual identity linking in Supabase.
# Allow /auth/callback and /auth/link/callback; verify real logins before handoff.
GOOGLE_AUTH_ENABLED=false
